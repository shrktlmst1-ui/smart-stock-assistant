# Polygon / Massive API (required for live data)
MASSIVE_API_KEY=
POLYGON_API_KEY=
POLYGON_PLAN=developer

# Market Pulse — نبض السوق الذكي (disabled by default)
MARKET_PULSE_ENABLED=false
MASSIVE_WS_URL=wss://socket.massive.com/stocks
BENZINGA_NEWS_URL=https://api.massive.com/benzinga/v2/news
MARKET_PULSE_MAX_SYMBOLS=50
MARKET_PULSE_SYMBOL_TTL_SECONDS=3600
MARKET_PULSE_ENTER_MIN_SCORE=85
MARKET_PULSE_WAIT_MIN_SCORE=65
MARKET_PULSE_MAX_SPREAD_BPS=50
MARKET_PULSE_DATA_MAX_AGE_SECONDS=120
MARKET_PULSE_ALERT_TTL_SECONDS=900
MARKET_PULSE_WS_BACKOFF_BASE_SECONDS=2
MARKET_PULSE_WS_BACKOFF_MAX_SECONDS=60
MARKET_PULSE_NEWS_POLL_SECONDS=60
MARKET_PULSE_BROADCAST_INTERVAL_SECONDS=5
MARKET_PULSE_WS_MAX_CLIENTS=50
# Dev/test only — blocked in production/release
MARKET_PULSE_FIXTURE_MODE=false

# App authentication (APP_PASSWORD in render.yaml for production; optional APP_PASSWORD_HASH)
APP_PASSWORD=
APP_PASSWORD_HASH=
APP_JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=480
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=60

# Watchlist (comma-separated, used for pulse subscriptions)
WATCHLIST=

# Scanner / Smart Opportunities (existing)
SMART_SCANNER_TOP_N=5
ENTRY_MIN_AI_SCORE=80
